# Manufacturing System Configuration
SECRET_KEY=django-insecure-manufacturing-system-secret-key-prod-2026-super-secure
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Database Configuration
# Option 1: Cloud PostgreSQL Connection String (Recommended for Vercel: Neon, Supabase, etc.)
DATABASE_URL=postgres://user:password@ep-sample-project.neon.tech/manufacturing_db?sslmode=require

# Option 2: Individual Postgres parameters
USE_POSTGRES=False
DB_NAME=manufacturing_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery (Optional for background workers)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Media and Static
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

