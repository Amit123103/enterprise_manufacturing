# Manufacturing System Configuration
SECRET_KEY=django-insecure-manufacturing-system-secret-key-prod-2026-super-secure
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL default, falls back to sqlite3 if DB_NAME is sqlite or postgres unavailable)
USE_POSTGRES=False
DB_NAME=manufacturing_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery (Optional for background workers)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Media and Static
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
